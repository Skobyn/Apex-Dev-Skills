#!/usr/bin/env python3
"""apex-console: a local admin console for apex-scope-loop, apex-dispatch and apex-decision-layer.

  apex-console serve [--port N] [--repo PATH]... [--open]
      Start the console on 127.0.0.1 and print its address (with this launch's token).
      Each --repo registers a repository (also done from the page). Ctrl-C stops it.
  apex-console repos [add PATH | remove ID]
  apex-console metrics [--repo ID|all] [--days N]      the /api/metrics JSON, for scripts
  apex-console progress                                the /api/progress JSON

The console reads what the plugins write and edits only settings they honour
(docs/adrs/0001-apex-console-contract.md). It never starts or drives work.
"""
import json
import os
import sys
import webbrowser

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts", "lib"))
import ac_server  # noqa: E402


def usage(code=2):
    print(__doc__.strip(), file=sys.stderr if code else sys.stdout)
    return code


def opt(args, name, default=None):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            raise SystemExit("apex-console: %s needs a value" % name)
        v = args[i + 1]
        del args[i:i + 2]
        return v
    return default


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        return usage(0 if argv else 2)
    cmd, args = argv[0], argv[1:]
    if cmd == "serve":
        repos = []
        while "--repo" in args:
            repos.append(opt(args, "--repo"))
        port = int(opt(args, "--port", os.environ.get("APEX_CONSOLE_PORT", "4747")))
        want_open = "--open" in args
        for r in repos:
            try:
                ac_server.add_repo(r)
            except ValueError as e:
                print("apex-console: %s" % e, file=sys.stderr)
                return 2
        try:
            httpd = ac_server.serve(port)
        except OSError as e:
            print("apex-console: cannot listen on 127.0.0.1:%d (%s); pass --port 0 for any free port" % (port, e),
                  file=sys.stderr)
            return 1
        url = "http://127.0.0.1:%d/?t=%s" % (httpd.server_address[1], httpd.token)
        print("CONSOLE_URL: %s" % url, flush=True)
        print("apex-console: serving %d repo(s) from %s; Ctrl-C stops it" % (len(ac_server.load_cfg()["repos"]),
                                                                          ac_server.cfg_path()), flush=True)
        if want_open:
            webbrowser.open(url)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass
        return 0
    if cmd == "repos":
        if args[:1] == ["add"] and len(args) == 2:
            rid, new = ac_server.add_repo(args[1])
            print("%s %s" % (rid, "added" if new else "already registered"))
            return 0
        if args[:1] == ["remove"] and len(args) == 2:
            ac_server.post_repos({"remove": args[1]})
            return 0
        for r in ac_server.load_cfg()["repos"]:
            print("%s\t%s" % (r["id"], r["path"]))
        return 0
    if cmd == "metrics":
        q = {"repo": opt(args, "--repo", "all"), "days": opt(args, "--days", "28")}
        print(json.dumps(ac_server.api_metrics(q), indent=2, default=str))
        return 0
    if cmd == "progress":
        print(json.dumps(ac_server.api_progress(), indent=2, default=str))
        return 0
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
