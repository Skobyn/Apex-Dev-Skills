  "tag_classes": [
    { "id": "gate-tags", "tags": ["gate", "gate:human", "gate:partner"], "class": "gate" },
    { "id": "security-tags", "tags": ["security", "auth", "pii", "consent", "money", "billing", "tier:c"], "class": "security" },
    { "id": "migration-tags", "tags": ["migration", "schema", "db", "data"], "class": "migration" },
    { "id": "bugfix-tags", "tags": ["bug", "bugfix", "fix", "regression", "incident"], "class": "bugfix" },
    { "id": "tests-tags", "tags": ["test", "tests", "qa", "e2e"], "class": "tests" },
    { "id": "docs-tags", "tags": ["docs", "doc", "readme", "adr"], "class": "docs" },
    { "id": "mechanical-tags", "tags": ["mechanical", "refactor", "rename", "chore", "deps", "lint"], "class": "mechanical" },
    { "id": "feature-tags", "tags": ["feature", "backend", "frontend", "ui", "api", "cli"], "class": "feature" }
  ],
  "hard_rules": [
    {
      "id": "tier-c-floor",
      "kind": "route_floor",
      "match": "any",
      "description": "Tier C, or security, migration, auth, pii, money or billing tags, route as class security: strong floor, six lenses plus adversarial, diversity block, single fan-out, no external builders, human gate G12 through checkpoint approve.",
      "when": { "risk_tier": "C", "tags_any": ["security", "migration", "tier:c", "auth", "pii", "money", "billing"] },
      "then": {
        "class": "security",
        "tier_floor": "strong",
        "review_shape": "fanout6+adversarial",
        "review_diversity": "block",
        "fanout": "single",
        "external_builders": false,
        "human_gate": "G12"
      }
    },
    {
      "id": "tier-b-review",
      "kind": "route_floor",
      "match": "all",
      "description": "Tier B reviews are six-lens with a diversity warning.",
      "when": { "risk_tier": "B" },
      "then": { "review_shape": "six-lens", "review_diversity": "warn" }
    },
    {
      "id": "no-runnable-check",
      "kind": "route_floor",
      "match": "all",
      "description": "A repo with no runnable check has no code-computed stop signal, so the floor is standard and the reviewer is a Claude reviewer.",
      "when": { "runnable_check": false },
      "then": { "tier_floor": "standard", "reviewer_family": "anthropic" }
    },
    {
      "id": "repeat-failure-floor",
      "kind": "route_floor",
      "match": "all",
      "description": "Two or more consecutive failures put the floor one rung above the last attempt.",
      "when": { "consecutive_failures_gte": 2 },
      "then": { "tier_floor_rungs_above_last": 1 }
    },
    {
      "id": "external-builder-scope",
      "kind": "route_floor",
      "match": "all",
      "description": "External providers build only docs, tests, mechanical and bugfix work at tier standard or below, and never Tier C.",
      "when": { "provider_external": true, "role": "builder" },
      "then": { "classes_only": ["docs", "tests", "mechanical", "bugfix"], "tier_ceiling": "standard" }
    },
    {
      "id": "deny-bypass-flags",
      "kind": "permission_deny",
      "description": "Layer A permission deny rules. Deny outranks every hook and verdict and holds in bypassPermissions. No ask rules anywhere.",
      "deny": [
        "Bash(* --dangerously-*)",
        "Bash(* --yolo*)",
        "Bash(* --always-approve*)",
        "Bash(* --full-auto*)",
        "Bash(git push --force*)"
      ]
    },
    {
      "id": "os-confinement",
      "kind": "sandbox",
      "description": "Layer I sandbox settings: the sandbox must be on, must fail when unavailable, and never runs commands unsandboxed. Allowed network domains come from the enabled providers' hosts.",
      "sandbox": { "enabled": true, "failIfUnavailable": true, "allowUnsandboxedCommands": false }
    }
  ],
  "escalation": {
    "max_review_rounds": 3,
    "prior_failure_summary_tokens": 400,
    "diagnoser_role": "diagnoser",
    "diagnoser_family": "different",
    "rungs": [
      { "id": "effort-up", "at_failures": 1, "action": "effort_up", "diagnoser": false },
      { "id": "model-up", "at_failures": 2, "action": "model_up", "diagnoser": true },
      { "id": "halt", "at_failures": 3, "action": "halt", "diagnoser": false }
    ]
  },
  "semantic": {
    "enabled": true,
    "cmd_env": "APEX_DECIDE_CMD",
    "default_cmd": "apex-decide",
    "timeout_ms": 2000,
    "min_p": 0.8,
    "uncalibrated_may_lower_cost": false,
    "uncertain_tier": "standard",
    "rubrics": {
      "task_class": "dispatch/task-class@1",
      "size": "dispatch/size@1",
      "lens_set": "dispatch/lens-set@1",
      "contamination": "dispatch/contamination@1",
      "risk_tier": "risk-tier@1",
      "escalation": "escalation@1"
    }
  },
