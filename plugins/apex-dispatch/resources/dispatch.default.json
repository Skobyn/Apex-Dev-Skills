  "roles": [
    {
      "id": "builder",
      "description": "Builds one routed task inside the plan worktree and commits it, confined to the task's owned paths. Dispatched by apex-dispatch exactly as routed.",
      "does": "Implement exactly the routed task in the plan worktree, staying inside the task's owned Paths, until its Acceptance check passes locally. Commit the work with a message naming the task.",
      "returns": "The commit SHA, the Acceptance command with its result, the files changed, and anything left undone stated plainly. Never claim done without the command output.",
      "tools": ["Read", "Grep", "Glob", "Edit", "Write", "MultiEdit", "Bash"],
      "disallowed_tools": ["Agent", "NotebookEdit"],
      "read_only": false,
      "maxTurns": 60,
      "effort": "medium",
      "effort_variants": ["high", "xhigh"],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "tester",
      "description": "Writes or repairs tests for one routed task inside the plan worktree, confined to the task's owned paths.",
      "does": "Add or repair the tests the routed task calls for, run them, and commit. Never delete, skip or weaken an existing test to reach green.",
      "returns": "The commit SHA, the test command with its pass and fail counts, and the tests added or changed.",
      "tools": ["Read", "Grep", "Glob", "Edit", "Write", "MultiEdit", "Bash"],
      "disallowed_tools": ["Agent", "NotebookEdit"],
      "read_only": false,
      "maxTurns": 50,
      "effort": "medium",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "docs",
      "description": "Writes or updates documentation for one routed docs task, confined to the task's owned paths.",
      "does": "Write or update the documentation the routed task names, matching the repo's existing voice and structure.",
      "returns": "The files changed and a one-paragraph summary of what a reader now learns that they could not before.",
      "tools": ["Read", "Grep", "Glob", "Edit", "Write", "MultiEdit"],
      "disallowed_tools": ["Agent", "Bash", "NotebookEdit"],
      "read_only": false,
      "maxTurns": 30,
      "effort": "low",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "researcher",
      "description": "Read-only researcher that answers one routed question from the repository and the web, without changing anything.",
      "does": "Answer the routed question from the repository and public sources. Change nothing.",
      "returns": "A direct answer first, then the evidence as file paths with line numbers or URLs, and what remains unknown.",
      "tools": ["Read", "Grep", "Glob", "WebSearch", "WebFetch"],
      "disallowed_tools": ["Bash", "Edit", "Write", "MultiEdit", "NotebookEdit", "Agent"],
      "read_only": true,
      "maxTurns": 30,
      "effort": "low",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "reviewer",
      "description": "Independent read-only reviewer for one routed task. Grades the exact head SHA from the brief against the Acceptance line and ends with one VERDICT line. Has no shell and no edit tools.",
      "does": "Review the diff named in the brief against the task's Acceptance line and the lenses the route assigns. The gate and Acceptance results are already in the brief; you have no shell, so cite them rather than re-running anything.",
      "returns": "Findings as file:line with a concrete failure scenario, a clearance line per lens, then, when the brief assigns you one lens of a Tier C fan-out, a line that is exactly LENS: <lens> (correctness, security, consent-pii, money, performance or maintainability), and a final line that is exactly VERDICT: APPROVE or VERDICT: REQUEST_CHANGES. The subagent-stop hook records that final line as your review; a missing or unreadable verdict line (anything but exactly APPROVE or REQUEST_CHANGES) is recorded as unparsed and blocks the task at this head.",
      "tools": ["Read", "Grep", "Glob"],
      "disallowed_tools": ["Bash", "Edit", "Write", "MultiEdit", "NotebookEdit", "Agent", "mcp__*"],
      "read_only": true,
      "maxTurns": 40,
      "effort": "high",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "reviewer-exec",
      "description": "Opt-in reviewer that may run read-only shell commands. No edit tools; its transcript is audited. Exists only when a repo opts in with the settings snippet applied.",
      "does": "Review the diff named in the brief and run read-only commands to confirm the Acceptance result. Never edit, commit or push.",
      "returns": "Findings as file:line with a concrete failure scenario, the commands run with their results, and a final line that is exactly VERDICT: APPROVE or VERDICT: REQUEST_CHANGES.",
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "disallowed_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit", "Agent", "mcp__*"],
      "read_only": true,
      "maxTurns": 40,
      "effort": "high",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": false
    },
    {
      "id": "adversarial-reviewer",
      "description": "Read-only refutation pass for Tier C reviews. Tries to break the approving reviewers' conclusions with concrete inputs. Has no shell and no edit tools.",
      "does": "Read the approving reviews and the diff in the brief, then try to refute each conclusion with a concrete input or state that produces a wrong result.",
      "returns": "Each refutation attempt with its input and outcome, and a final line that is exactly VERDICT: APPROVE or VERDICT: REQUEST_CHANGES.",
      "tools": ["Read", "Grep", "Glob"],
      "disallowed_tools": ["Bash", "Edit", "Write", "MultiEdit", "NotebookEdit", "Agent", "mcp__*"],
      "read_only": true,
      "maxTurns": 40,
      "effort": "high",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "diagnoser",
      "description": "Read-only diagnoser called on the second failure of a task. Explains why the previous attempts failed so the next builder starts from a cause, not a symptom.",
      "does": "Read the failure summaries, the diff and the gate output in the brief and locate the root cause. Change nothing.",
      "returns": "The root cause with file:line evidence, the smallest fix that addresses it, and what the next attempt must not repeat, in under 400 words.",
      "tools": ["Read", "Grep", "Glob"],
      "disallowed_tools": ["Bash", "Edit", "Write", "MultiEdit", "NotebookEdit", "Agent", "mcp__*"],
      "read_only": true,
      "maxTurns": 40,
      "effort": "high",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    },
    {
      "id": "provider-runner",
      "description": "Runs one external worker shim for a routed task and reports its result. Calls only the bin/worker scripts; never edits files.",
      "does": "Run the single worker shim command given in the brief from the orchestrator's instructions, wait for its DISPATCH-DONE sentinel, and read its result file.",
      "returns": "The shim's exit code, the sentinel line, and the path and contents summary of its result file. Never apply the patch yourself.",
      "tools": ["Read", "Bash"],
      "disallowed_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit", "Agent", "mcp__*"],
      "read_only": true,
      "maxTurns": 20,
      "effort": "low",
      "effort_variants": [],
      "mcp_allow": [],
      "enabled": true
    }
  ],
