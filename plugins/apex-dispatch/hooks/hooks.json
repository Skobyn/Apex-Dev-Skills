{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-agent.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-edit.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-mcp.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^mcp__"
      }
    ]
  }
}
