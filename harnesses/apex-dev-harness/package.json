{
  "name": "apex-dev-harness",
  "version": "0.3.0",
  "description": "Routing and gate engine for apex-app: lanes, surface ledger, guardrails, and computed done-obligations.",
  "type": "module",
  "bin": {
    "apex": "bin/apex.js"
  },
  "main": "./dist/route.js",
  "types": "./dist/route.d.ts",
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle:plugin",
    "bundle:plugin": "node scripts/bundle-plugin.js",
    "verify:bundle": "node scripts/verify-bundle.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
